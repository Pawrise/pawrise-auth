# Copier en .env pour le développement local (npm run dev).
NODE_ENV=development
PORT=8200
DATABASE_URL=postgresql://pawrise_auth:pawrise_auth@localhost:54330/pawrise_auth
PUBLIC_BASE_URL=http://localhost:8200

# 32 caractères minimum ; en production, une valeur aléatoire gardée dans les secrets.
EMAIL_TOKEN_SECRET=dev-only-secret-change-me-0123456789abcdef

# Clé RS256 : absente en dev (créée dans .keys/), obligatoire en production (PEM PKCS#8, \n acceptés).
# JWT_PRIVATE_KEY=
# JWT_KEY_ID=
JWT_ISSUER=https://auth.pawrise.fr
JWT_AUDIENCE=pawrise-api

TERMS_VERSION=2026-10
ANONYMIZED_DATA_POLICY_VERSION=2026-10

SMTP_URL=smtp://localhost:1125
MAIL_FROM=Pawrise <no-reply@pawrise.fr>

HIBP_ENABLED=true

# Identifiants clients acceptés dans `aud` (séparés par des virgules).
APPLE_AUDIENCES=fr.pawrise.app
GOOGLE_CLIENT_IDS=

TRUST_PROXY_HOPS=0
